# docker-compose.external.yaml 对应的单机外部依赖部署模板
# 用法：
#   docker compose --env-file .env.external -f docker-compose.external.yaml up -d

# 镜像与端口
NEW_API_IMAGE=ghcr.io/bobobi0208/new-api:latest
PORT=3000
TZ=Asia/Shanghai

# 外部数据库
# MySQL 示例：
SQL_DSN=root:change-me@tcp(10.0.0.10:3306)/new-api?charset=utf8mb4&parseTime=True&loc=Local
# PostgreSQL 可改成：
# SQL_DSN=postgres://user:pass@10.0.0.10:5432/new-api?sslmode=disable
LOG_SQL_DSN=
SQL_MAX_IDLE_CONNS=100
SQL_MAX_OPEN_CONNS=1000
SQL_MAX_LIFETIME=60

# 外部 Redis
REDIS_CONN_STRING=redis://:change-me@10.0.0.20:6379/1
SYNC_FREQUENCY=60
MEMORY_CACHE_ENABLED=false

# 应用开关
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
STREAMING_TIMEOUT=300

# 会话与加密密钥
SESSION_SECRET=change-this-to-a-long-random-string
CRYPTO_SECRET=change-this-to-another-long-random-string
